rules_version = '2';

// Khabri Dost security rules — the real security boundary.
// Role lists must stay identical to src/utils/roles.ts (used by the app and the server).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function changed() {
      return incoming().diff(existing()).affectedKeys();
    }
    function validId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[A-Za-z0-9_-]+$');
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email is string && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // Owner accounts (bootstrap). Everyone else is invited through the `staff` collection.
    function isOwner() {
      return verifiedEmail() && myEmail() in ['khabridost.com@gmail.com', 'khabaridost.com@gmail.com'];
    }
    function staffRecordPath() {
      return /databases/$(database)/documents/staff/$(myEmail());
    }
    function staffRole() {
      return get(staffRecordPath()).data.role;
    }
    function activeStaff() {
      return verifiedEmail() && exists(staffRecordPath()) && get(staffRecordPath()).data.status == 'active';
    }
    function isAdmin() {
      return isOwner() || (activeStaff() && staffRole() in ['super_admin']);
    }
    function isEditor() {
      return isAdmin() || (activeStaff() && staffRole() in ['editor_in_chief', 'senior_editor', 'editor', 'sub_editor']);
    }
    function isStaff() {
      return isEditor() || (activeStaff() && staffRole() in
        ['reporter', 'journalist', 'contributor', 'fact_checker', 'seo_manager', 'analyst']);
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Articles ----------
    function validArticle(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 300 &&
             shortString(d.summary, 2000) &&
             d.content is string && d.content.size() <= 300000 &&
             shortString(d.category, 50) &&
             shortString(d.authorName, 120) &&
             shortString(d.authorUid, 128) &&
             d.status in ['draft', 'pending_review', 'scheduled', 'published', 'archived'];
    }
    // Reporters may only save drafts and submissions for review; publishing is for editors.
    function reporterStatusOk(d) {
      return d.status in ['draft', 'pending_review'];
    }
    match /articles/{articleId} {
      allow get, list: if resource.data.status == 'published' ||
                          isEditor() ||
                          (isStaff() && resource.data.authorUid == request.auth.uid);
      allow create: if validId(articleId) && validArticle(incoming()) && (
                      isEditor() ||
                      (isStaff() && incoming().authorUid == request.auth.uid && reporterStatusOk(incoming())));
      allow update: if validId(articleId) && (
        (isEditor() && validArticle(incoming())) ||
        (isStaff() && existing().authorUid == request.auth.uid &&
          incoming().authorUid == existing().authorUid &&
          reporterStatusOk(existing()) && reporterStatusOk(incoming()) && validArticle(incoming())) ||
        // Public counters on published articles: exactly +1 view, ±1 like, reactions map by signed-in readers.
        (existing().status == 'published' && changed().hasOnly(['viewsCount']) &&
          incoming().viewsCount == existing().get('viewsCount', 0) + 1) ||
        (existing().status == 'published' && signedIn() && changed().hasOnly(['likesCount']) &&
          (incoming().likesCount == existing().get('likesCount', 0) + 1 ||
           incoming().likesCount == existing().get('likesCount', 0) - 1)) ||
        (existing().status == 'published' && signedIn() && changed().hasOnly(['reactions']) &&
          incoming().reactions is map && incoming().reactions.size() <= 12)
      );
      allow delete: if isAdmin();
    }

    // ---------- Comments ----------
    function validComment(d) {
      return shortString(d.articleId, 128) && shortString(d.authorUid, 128) &&
             shortString(d.authorName, 100) &&
             d.content is string && d.content.size() >= 1 && d.content.size() <= 2000;
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && validId(commentId) && validComment(incoming()) &&
                       incoming().authorUid == request.auth.uid;
      allow update: if signedIn() && validId(commentId) && (
        isEditor() ||
        (existing().authorUid == request.auth.uid && incoming().authorUid == existing().authorUid && validComment(incoming())) ||
        (changed().hasOnly(['likesCount']) &&
          (incoming().likesCount == existing().get('likesCount', 0) + 1 ||
           incoming().likesCount == existing().get('likesCount', 0) - 1))
      );
      allow delete: if validId(commentId) && (isEditor() || (signedIn() && existing().authorUid == request.auth.uid));
    }

    // ---------- Reader lists (private) ----------
    match /bookmarks/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validId(id) && incoming().userId == request.auth.uid;
      allow delete: if signedIn() && validId(id) && existing().userId == request.auth.uid;
    }
    match /read_laters/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validId(id) && incoming().userId == request.auth.uid;
      allow delete: if signedIn() && validId(id) && existing().userId == request.auth.uid;
    }

    // ---------- Reader profiles (private; roles live in `staff`) ----------
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId && validId(userId) &&
                       (!('role' in incoming()) || incoming().role == 'reader');
      allow update: if signedIn() && validId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && !changed().hasAny(['role', 'uid']))
      );
      allow delete: if isAdmin();
    }

    // ---------- Newsroom staff (invites + roles), id = lower-cased email ----------
    function validStaff(d, id) {
      return d.email == id && shortString(d.name, 120) &&
             d.role in ['super_admin', 'editor_in_chief', 'senior_editor', 'editor', 'sub_editor',
                        'reporter', 'journalist', 'contributor', 'fact_checker', 'seo_manager', 'analyst'] &&
             d.status in ['active', 'suspended', 'pending'] &&
             !('accessPin' in d);
    }
    match /staff/{email} {
      allow get: if isAdmin() || (verifiedEmail() && myEmail() == email);
      allow list: if isAdmin();
      // Administrators manage staff; only the owner accounts can create or change other administrators.
      allow create, update: if isAdmin() && validStaff(incoming(), email) &&
                               (incoming().role != 'super_admin' || isOwner()) &&
                               (resource == null || existing().role != 'super_admin' || isOwner());
      allow delete: if isAdmin() && (existing().role != 'super_admin' || isOwner());
    }

    // Legacy admin registry (read-only now; kept so old documents remain readable by their owner).
    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // ---------- Site settings (public; never store secrets here) ----------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.size() < 400 &&
                      !('geminiApiKey' in incoming()) && !('openaiApiKey' in incoming());
    }

    // ---------- Newsletter subscribers ----------
    match /subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if validId(subscriberId) &&
                       incoming().email is string && incoming().email.size() <= 254 &&
                       incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
                       incoming().keys().hasOnly(['id', 'email', 'name', 'status', 'source', 'subscribedAt', 'tags', 'preferredCategories']) &&
                       incoming().status == 'active';
    }

    // ---------- Media ----------
    match /media/{mediaId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isEditor();
    }

    // ---------- Live coverage ----------
    match /live_blogs/{blogId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isEditor();
    }

    // ---------- Contact form ----------
    match /inquiries/{inquiryId} {
      allow read, update, delete: if isEditor();
      allow create: if validId(inquiryId) &&
                       shortString(incoming().name, 120) &&
                       shortString(incoming().email, 254) &&
                       incoming().message is string && incoming().message.size() >= 1 && incoming().message.size() <= 5000 &&
                       incoming().keys().size() <= 14;
    }

    // ---------- Reader news submissions ----------
    match /submissions/{submissionId} {
      allow read, update, delete: if isEditor();
      // Anyone may send a news tip; editors review it. Images are small compressed data URLs or links.
      allow create: if validId(submissionId) &&
                       incoming().id == submissionId &&
                       incoming().status == 'pending' &&
                       incoming().title is string && incoming().title.size() >= 5 && incoming().title.size() <= 300 &&
                       incoming().description is string && incoming().description.size() >= 10 && incoming().description.size() <= 20000 &&
                       shortString(incoming().location, 200) &&
                       shortString(incoming().category, 50) &&
                       shortString(incoming().senderName, 120) &&
                       incoming().images is list && incoming().images.size() <= 4 &&
                       incoming().keys().hasOnly(['id', 'title', 'category', 'location', 'incidentDate', 'description',
                         'images', 'videoUrl', 'senderName', 'senderPhone', 'senderEmail', 'isAnonymous',
                         'submittedAt', 'status']);
    }
  }
}
